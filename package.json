{
  "name": "@entradasya/orders",
  "version": "0.1.0",
  "private": true,
  "description": "EntradasYa - órdenes, coordinación de compra y reportes de ventas (P3)",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:down": "tsx --env-file-if-exists=.env scripts/migrate.ts down",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
